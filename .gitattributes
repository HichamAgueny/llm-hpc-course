# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always have LF line endings
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.def text eol=lf

# Denote all binary files
*.sif binary
*.png binary
*.jpg binary
*.jpeg binary

