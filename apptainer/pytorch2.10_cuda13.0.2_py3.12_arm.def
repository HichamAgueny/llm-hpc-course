Bootstrap: localimage
From: /cluster/work/projects/nn9997k/hicham/apptainer/pytorch_25.08_cuda13.0_base_arm.sif

%files
    # Apptainer implicitly copies: [source_on_host] [destination_in_container]
    requirements.txt /requirements.txt

%post
    set -e

    # Step 1: Install everything in the file normally
    pip install --no-build-isolation --no-cache-dir -r /requirements.txt

    # Step 2: Run a targeted strike to force-reinstall just peft right on top
    pip install --no-cache-dir --no-deps peft==0.14.0

    # Clean up the requirements file after install
    rm /requirements.txt

    # Python symlinks
    mkdir -p /opt/python
    ln -sf /usr/bin/python3.12 /opt/python/python3.12
    ln -sf /usr/bin/python3    /opt/python/python3
    ln -sf /usr/bin/python     /opt/python/python

%environment
    export PATH="/opt/python:$PATH"
