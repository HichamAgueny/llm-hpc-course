#!/bin/bash
# Start an interactive shell on a compute node.   Usage: bash srun_sinteractive-cpu
source "$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../.." && pwd)/course_env.sh"

srun -A "${COURSE_SLURM_ACCOUNT}" ${COURSE_SLURM_RESERVATION:+--reservation="${COURSE_SLURM_RESERVATION}"} \
     --nodes=1 --ntasks=1 --mem-per-cpu=8G --time=00:50:00 --pty bash -i
